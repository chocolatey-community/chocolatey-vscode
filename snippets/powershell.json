      "\\$checksumType = '${3|md5,sha1,sha256,sha512|}'",
      "Get-ChecksumValid -File \\$file -Checksum \\$expectedChecksum -ChecksumType \\$checksumType"
    ],
    "description": "Chocolatey Get-ChecksumValid Helper Function"
  },
